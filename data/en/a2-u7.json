      "n": 2,
      "titulo": "Me siento mal",
      "objetivo": "Decir qué síntomas tienes y cómo te sientes.",
      "intro": "Para los síntomas se usa have: I have a headache (tengo dolor de cabeza). Para decir cómo estás, usa I feel + adjetivo: I feel tired. Truco: en inglés se «tiene» un dolor, no se «está con» él.",
      "palabras": [
        { "t": "headache", "es": "dolor de cabeza", "pron": "jédeik", "ej": "I have a headache.", "ejes": "Tengo dolor de cabeza.", "cog": false, "truco": "head + ache (dolor): jédeik." },
        { "t": "stomachache", "es": "dolor de estómago", "pron": "stómakeik", "ej": "I have a stomachache.", "ejes": "Tengo dolor de estómago.", "cog": false },
        { "t": "cold", "es": "resfriado", "pron": "cóuld", "ej": "I have a cold.", "ejes": "Tengo un resfriado.", "cog": false, "truco": "cold también significa «frío»." },
        { "t": "cough", "es": "tos", "pron": "cof", "ej": "I have a bad cough.", "ejes": "Tengo mucha tos.", "cog": false },
        { "t": "fever", "es": "fiebre", "pron": "fíver", "ej": "She has a fever.", "ejes": "Ella tiene fiebre.", "cog": true },
        { "t": "sore throat", "es": "dolor de garganta", "pron": "sor zróut", "ej": "I have a sore throat.", "ejes": "Tengo dolor de garganta.", "cog": false },
        { "t": "tired", "es": "cansado", "pron": "táierd", "ej": "I feel tired today.", "ejes": "Hoy me siento cansado.", "cog": false },
        { "t": "sick", "es": "enfermo", "pron": "sik", "ej": "My son is sick.", "ejes": "Mi hijo está enfermo.", "cog": false },
        { "t": "feel", "es": "sentir(se)", "pron": "fil", "ej": "I don't feel well.", "ejes": "No me siento bien.", "cog": false }
      ],
      "frases": [
        { "t": "I have a headache.", "es": "Tengo dolor de cabeza.", "pron": "ai jav a jédeik" },
        { "t": "I have a cold.", "es": "Tengo un resfriado.", "pron": "ai jav a cóuld" },
        { "t": "She has a fever.", "es": "Ella tiene fiebre.", "pron": "shi jas a fíver" },
        { "t": "I feel sick.", "es": "Me siento mal.", "pron": "ai fil sik" },
        { "t": "I don't feel well.", "es": "No me siento bien.", "pron": "ai dount fil uel" },
        { "t": "He is tired and sick.", "es": "Él está cansado y enfermo.", "pron": "ji is táierd an sik" }
      ],
      "dialogo": {
        "titulo": "En la oficina",
        "lineas": [
          { "q": "A", "t": "You look tired, Rosa.", "es": "Te ves cansada, Rosa." },
          { "q": "B", "t": "Yes, I don't feel well.", "es": "Sí, no me siento bien." },
          { "q": "A", "t": "Do you have a fever?", "es": "¿Tienes fiebre?" },
          { "q": "B", "t": "No, I have a sore throat and a cough.", "es": "No, tengo dolor de garganta y tos." }
        ]
      },
      "nota": "Con la tercera persona, have cambia a has: she has a fever, he has a cold. Para el estado general se dice I feel sick o I'm sick; para la gripe se usa I have the flu."
    },

      "dialogo": {
        "titulo": "Una llamada a un amigo",
        "lineas": [
          { "q": "A", "t": "Hi, Tom. What's the matter?", "es": "Hola, Tom. ¿Qué te pasa?" },
          { "q": "B", "t": "I have a toothache. It's worse today.", "es": "Tengo dolor de muela. Hoy está peor." },
          { "q": "A", "t": "You should see the dentist.", "es": "Deberías ir al dentista." },

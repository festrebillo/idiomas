{
  "id": "en-a2-u7",
  "idioma": "en",
  "nivel": "A2",
  "n": 7,
  "titulo": "Salud y cuerpo",
  "resumen": "Aprenderás a nombrar partes del cuerpo, decir qué te duele, hablar con un médico o en la farmacia y dar consejos con should y shouldn't.",
  "puedo": [
    "Nombrar las partes principales del cuerpo.",
    "Decir qué me duele y cómo me siento.",
    "Entender y dar instrucciones simples (Take..., Drink..., Rest).",
    "Dar consejos con should y shouldn't.",
    "Hablar con un médico o en una farmacia."
  ],
  "gramatica": {
    "titulo": "Should y shouldn't para dar consejos",
    "texto": "Should significa «debería» y sirve para dar un consejo. Shouldn't significa «no debería». Truco: should es un consejo amable, no una orden.\nSe usa igual con todas las personas (I, you, he, she, we, they) y siempre va seguido del verbo sin to y sin -s: You should rest. She should drink water.\nPara preguntar un consejo se pone should al inicio: Should I see a doctor? (¿Debería ir al médico?).",
    "tabla": [
      ["You should rest.", "Deberías descansar.", "iu shud rest"],
      ["He should drink water.", "Él debería tomar agua.", "ji shud drink uóter"],
      ["You shouldn't work today.", "No deberías trabajar hoy.", "iu shúdnt uérk tudéi"],
      ["Should I see a doctor?", "¿Debería ir al médico?", "shud ai si a dóctor"],
      ["Yes, you should.", "Sí, deberías.", "ies, iu shud"]
    ],
    "errores": [
      "No pongas to después de should: es You should rest, no «You should to rest».",
      "No añadas -s con he o she: He should sleep, no «He shoulds sleep».",
      "La «l» de should no se pronuncia: suena «shud»."
    ]
  },
  "practica": [
    "Señala 8 partes de tu cuerpo y di su nombre en inglés en voz alta: This is my hand (5 minutos).",
    "Escribe 5 consejos para un amigo con gripe usando You should... y You shouldn't... (8 minutos).",
    "Representa en voz alta una visita al médico: tú eres el paciente y dices qué te duele (5 minutos).",
    "Busca en internet la caja de una medicina en inglés y lee en voz alta las instrucciones (5 minutos)."
  ],
  "lecciones": [
    {
      "id": "en-a2-u7-l1",
      "n": 1,
      "titulo": "Partes del cuerpo",
      "objetivo": "Nombrar partes del cuerpo y decir cuál te duele.",
      "intro": "Empezamos por el cuerpo. Para decir qué te duele usa My + parte del cuerpo + hurts: My head hurts. Truco: hurts suena «jerts» y es como decir «me duele».",
      "palabras": [
        { "t": "head", "es": "cabeza", "pron": "jed", "ej": "My head hurts.", "ejes": "Me duele la cabeza.", "cog": false },
        { "t": "back", "es": "espalda", "pron": "bak", "ej": "My back hurts.", "ejes": "Me duele la espalda.", "cog": false, "truco": "back también significa «de vuelta», pero aquí es la espalda." },
        { "t": "stomach", "es": "estómago", "pron": "stómak", "ej": "My stomach hurts.", "ejes": "Me duele el estómago.", "cog": true, "truco": "La «ch» de stomach suena «k»: stómak." },
        { "t": "throat", "es": "garganta", "pron": "zróut", "ej": "My throat hurts.", "ejes": "Me duele la garganta.", "cog": false },
        { "t": "arm", "es": "brazo", "pron": "arm", "ej": "My arm hurts.", "ejes": "Me duele el brazo.", "cog": false },
        { "t": "leg", "es": "pierna", "pron": "leg", "ej": "My leg hurts.", "ejes": "Me duele la pierna.", "cog": false },
        { "t": "hand", "es": "mano", "pron": "jand", "ej": "My hand hurts.", "ejes": "Me duele la mano.", "cog": false },
        { "t": "foot", "es": "pie", "pron": "fut", "ej": "My foot hurts.", "ejes": "Me duele el pie.", "cog": false, "truco": "El plural es irregular: one foot, two feet." },
        { "t": "hurts", "es": "duele", "pron": "jerts", "ej": "My back hurts.", "ejes": "Me duele la espalda.", "cog": false }
      ],
      "frases": [
        { "t": "My head hurts.", "es": "Me duele la cabeza.", "pron": "mai jed jerts" },
        { "t": "My back hurts.", "es": "Me duele la espalda.", "pron": "mai bak jerts" },
        { "t": "My throat hurts.", "es": "Me duele la garganta.", "pron": "mai zróut jerts" },
        { "t": "My feet hurt.", "es": "Me duelen los pies.", "pron": "mai fit jert" },
        { "t": "Where does it hurt?", "es": "¿Dónde te duele?", "pron": "juér das it jert" }
      ],
      "dialogo": {
        "titulo": "Después de correr",
        "lineas": [
          { "q": "A", "t": "Are you okay, Luis?", "es": "¿Estás bien, Luis?" },
          { "q": "B", "t": "No, my leg hurts.", "es": "No, me duele la pierna." },
          { "q": "A", "t": "And your foot?", "es": "¿Y tu pie?" },
          { "q": "B", "t": "My foot hurts too.", "es": "El pie también me duele." }
        ]
      },
      "nota": "Con partes del cuerpo en plural se dice hurt sin -s: My feet hurt, my hands hurt. Con una sola parte, hurts."
    },
    {

        { "t": "prenotare", "es": "reservar", "pron": "prenotáre", "ej": "Vorrei prenotare un tavolo.", "ejes": "Quisiera reservar una mesa.", "cog": false },
        { "t": "la prenotazione", "es": "la reserva", "pron": "la prenotatsióne", "ej": "La prenotazione è per le otto.", "ejes": "La reserva es para las ocho.", "cog": false },
        { "t": "siamo in", "es": "somos (cuántos)", "pron": "siámo in", "ej": "Siamo in tre.", "ejes": "Somos tres.", "cog": false },

  "gramatica": {
    "titulo": "El partitivo: del, dello, della, dei, delle",
    "texto": "Cuando quieres «algo de» o «un poco de» una cosa, sin decir la cantidad exacta, usas el partitivo: de + el artículo. En español basta decir «quisiera pan»; en italiano suele decirse «vorrei del pane».\nLas formas son como los artículos que ya sabes: del (il), dello (lo), della (la), dell' (l'), dei (i), degli (gli), delle (le).\nEjemplos: del pane, dello zucchero, della frutta, dell'acqua, dei panini, delle patate.\nNo se usa en frases negativas: «Non voglio pane», no «non voglio del pane».",
    "tabla": [
      ["del pane", "(algo de) pan", "del páne"],
      ["dello zucchero", "(algo de) azúcar", "délo dsúquero"],
      ["della frutta", "(algo de) fruta", "déla frúta"],
      ["dell'acqua", "(algo de) agua", "delákua"],
      ["dei panini", "(unos) sándwiches", "déi paníni"],
      ["delle patate", "(unas) papas", "dele patáte"]
    ],
    "errores": [
      "No omitas el partitivo siempre: en italiano «Vorrei pane» suena pobre; mejor «Vorrei del pane».",
      "En frases negativas no se usa: «Non ho pane» (no «non ho del pane»).",
      "Elige la forma según el artículo: del pane, della pasta, dello zucchero, dell'olio."
    ]
  },
  "practica": [
    "Abre tu refrigerador y di 10 alimentos con el partitivo: «del latte, della frutta, dei pomodori...» (5 minutos).",
    "Escribe un pedido de restaurante completo: entrada, plato fuerte, bebida y postre (5 minutos).",
    "Practica en voz alta el diálogo de la reserva cambiando el número de personas y la hora (5 minutos).",
    "Di cinco frases con «molto», «poco» o «troppo» sobre tus comidas favoritas (3 minutos)."
  ],
  "lecciones": [
    {
      "id": "it-a2-u8-l1",
      "n": 1,
      "titulo": "El menú italiano",
      "objetivo": "Reconocer las partes de un menú y nombrar platos típicos.",
      "intro": "Un menú italiano tiene un orden: antipasto, primo, secondo, contorno y dolce. Truco: «primo» es casi siempre pasta o sopa y «secondo» es carne o pescado.",
      "palabras": [
        { "t": "l'antipasto", "es": "la entrada", "pron": "lantipásto", "ej": "L'antipasto è buono.", "ejes": "La entrada está rica.", "cog": false },
        { "t": "il primo", "es": "el primer plato (pasta, arroz, sopa)", "pron": "il prímo", "ej": "Il primo è la pasta.", "ejes": "El primer plato es la pasta.", "cog": false },
        { "t": "il secondo", "es": "el segundo plato (carne, pescado)", "pron": "il secóndo", "ej": "Il secondo è il pollo.", "ejes": "El segundo es el pollo.", "cog": false },
        { "t": "il contorno", "es": "la guarnición", "pron": "il contórno", "ej": "Il contorno è l'insalata.", "ejes": "La guarnición es la ensalada.", "cog": false },
        { "t": "il dolce", "es": "el postre", "pron": "il dólche", "ej": "Il dolce è squisito.", "ejes": "El postre está exquisito.", "cog": false },
        { "t": "il pesce", "es": "el pescado", "pron": "il péshe", "ej": "Il pesce è fresco.", "ejes": "El pescado está fresco.", "cog": false, "truco": "«sce» suena «she»." },
        { "t": "la carne", "es": "la carne", "pron": "la cárne", "ej": "La carne è buona.", "ejes": "La carne está rica.", "cog": true },
        { "t": "il pollo", "es": "el pollo", "pron": "il póllo", "ej": "Il pollo con le patate.", "ejes": "El pollo con papas.", "cog": true },
        { "t": "il gelato", "es": "el helado", "pron": "il yeláto", "ej": "Il gelato è molto buono.", "ejes": "El helado está muy rico.", "cog": false },
        { "t": "il menù", "es": "el menú", "pron": "il menú", "ej": "Il menù è lungo.", "ejes": "El menú es largo.", "cog": true }
      ],
      "frases": [
        { "t": "Come antipasto, il prosciutto.", "es": "De entrada, el jamón.", "pron": "kóme antipásto, il proshútto" },
        { "t": "Come primo, la pasta.", "es": "De primer plato, la pasta.", "pron": "kóme prímo, la pásta" },
        { "t": "Come secondo, il pesce.", "es": "De segundo, el pescado.", "pron": "kóme secóndo, il péshe" },
        { "t": "Come dolce, il gelato.", "es": "De postre, el helado.", "pron": "kóme dólche, il yeláto" }
      ],
      "dialogo": {
        "titulo": "Leyendo el menú",
        "lineas": [
          { "q": "A", "t": "Che cosa prendi come primo?", "es": "¿Qué tomas de primer plato?" },
          { "q": "B", "t": "La pasta. E tu?", "es": "La pasta. ¿Y tú?" },
          { "q": "A", "t": "Io prendo la zuppa. Come secondo, il pollo.", "es": "Yo tomo la sopa. De segundo, el pollo." },
          { "q": "B", "t": "Io il pesce. E come dolce, il gelato!", "es": "Yo el pescado. ¡Y de postre, el helado!" }
        ]
      },
      "nota": "Una comida completa en Italia sigue ese orden, pero nadie está obligado a pedir todo: muchos piden solo un primo o un secondo. «Prendo» (tomo) se usa mucho al pedir."
    },
    {
      "id": "it-a2-u8-l2",
      "n": 2,
      "titulo": "Pedir con «del» y «della»",
      "objetivo": "Pedir comida y bebida usando el partitivo.",
      "intro": "Aquí aparece la idea de la unidad: «algo de» se dice «del / della». Truco: es «de» + el artículo que ya conoces: il pane → del pane; la frutta → della frutta.",
      "palabras": [
        { "t": "del pane", "es": "(algo de) pan", "pron": "del páne", "ej": "Vorrei del pane, per favore.", "ejes": "Quisiera pan, por favor.", "cog": false },
        { "t": "dello zucchero", "es": "(algo de) azúcar", "pron": "délo dsúquero", "ej": "Posso avere dello zucchero?", "ejes": "¿Me da azúcar?", "cog": false },
        { "t": "della frutta", "es": "(algo de) fruta", "pron": "déla frúta", "ej": "Prendo della frutta.", "ejes": "Tomo fruta.", "cog": false },
        { "t": "dell'acqua", "es": "(algo de) agua", "pron": "delákua", "ej": "Vorrei dell'acqua, per favore.", "ejes": "Quisiera agua, por favor.", "cog": false },
        { "t": "dei panini", "es": "(unos) sándwiches", "pron": "déi paníni", "ej": "Ci sono dei panini?", "ejes": "¿Hay sándwiches?", "cog": false },
        { "t": "delle patate", "es": "(unas) papas", "pron": "déle patáte", "ej": "Vorrei delle patate.", "ejes": "Quisiera papas.", "cog": false },
        { "t": "del formaggio", "es": "(algo de) queso", "pron": "del formáddyo", "ej": "Prendo del formaggio.", "ejes": "Tomo queso.", "cog": false, "truco": "«gg» + i suena «dy»." },
        { "t": "del riso", "es": "(algo de) arroz", "pron": "del ríso", "ej": "Vorrei del riso.", "ejes": "Quisiera arroz.", "cog": false },
        { "t": "dell'olio", "es": "(algo de) aceite", "pron": "delólio", "ej": "Vorrei dell'olio.", "ejes": "Quisiera aceite.", "cog": false }
      ],
      "frases": [
        { "t": "Vorrei del pane, per favore.", "es": "Quisiera pan, por favor.", "pron": "vorréi del páne, per favóre" },
        { "t": "Posso avere dell'acqua?", "es": "¿Me da agua?", "pron": "pósso avére delákua" },
        { "t": "Prendo della frutta.", "es": "Tomo fruta.", "pron": "préndo déla frúta" },
        { "t": "Non voglio formaggio, grazie.", "es": "No quiero queso, gracias.", "pron": "non vóllio formáddyo, grátsie" },
        { "t": "Ci sono dei panini?", "es": "¿Hay sándwiches?", "pron": "chi sóno déi paníni" }
      ],
      "dialogo": {
        "titulo": "En la mesa",
        "lineas": [
          { "q": "A", "t": "Vorrei del pane, per favore.", "es": "Quisiera pan, por favor." },
          { "q": "B", "t": "Certo! Vuole anche dell'acqua?", "es": "¡Claro! ¿Quiere también agua?" },
          { "q": "A", "t": "Sì, grazie. E posso avere dell'olio?", "es": "Sí, gracias. ¿Y me da aceite?" },
          { "q": "B", "t": "Ecco a lei!", "es": "¡Aquí tiene!" }
        ]
      },
      "nota": "«Ci sono» significa «hay» (plural) y «c'è» «hay» (singular). El partitivo es muy natural en italiano hablado. En negativo se omite: «Non ho pane»."
    },

        { "t": "la carta di credito", "es": "la tarjeta de crédito", "pron": "la cárta di crédito", "ej": "Posso pagare con la carta di credito?", "ejes": "¿Puedo pagar con tarjeta de crédito?", "cog": true }
      ],
      "frases": [

        { "t": "poco", "es": "poco (masc.)", "pron": "póco", "ej": "Bevo poco vino.", "ejes": "Bebo poco vino.", "cog": true, "truco": "Femenino: poca; plural: pochi, poche." },
        { "t": "troppo", "es": "demasiado", "pron": "tróppo", "ej": "C'è troppo sale.", "ejes": "Hay demasiada sal.", "cog": false },
        { "t": "abbastanza", "es": "bastante", "pron": "abbastántsa", "ej": "Il pranzo è abbastanza caro.", "ejes": "El almuerzo es bastante caro.", "cog": false },
        { "t": "quanto", "es": "cuánto (masc.)", "pron": "cuánto", "ej": "Quanto pane vuoi?", "ejes": "¿Cuánto pan quieres?", "cog": true, "truco": "Femenino: quanta; plural: quanti, quante." },
        { "t": "un po' di", "es": "un poco de", "pron": "un po di", "ej": "Vorrei un po' di vino.", "ejes": "Quisiera un poco de vino.", "cog": false },
        { "t": "un chilo", "es": "un kilo", "pron": "un quílo", "ej": "Vorrei un chilo di pasta.", "ejes": "Quisiera un kilo de pasta.", "cog": true },
        { "t": "il sale", "es": "la sal", "pron": "il sále", "ej": "Il sale, per favore.", "ejes": "La sal, por favor.", "cog": true },
        { "t": "la bottiglia", "es": "la botella", "pron": "la bottíllia", "ej": "La bottiglia è piena.", "ejes": "La botella está llena.", "cog": false }

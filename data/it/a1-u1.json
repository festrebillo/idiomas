      "dialogo": {
        "titulo": "Un saludo entre amigos",
        "lineas": [
          { "q": "A", "t": "Ciao, Marco!", "es": "¡Hola, Marco!" },
          { "q": "B", "t": "Ciao, Giulia!", "es": "¡Hola, Giulia!" },
          { "q": "A", "t": "Grazie, Marco!", "es": "¡Gracias, Marco!" },
          { "q": "B", "t": "Prego, Giulia! Arrivederci!", "es": "¡De nada, Giulia! ¡Adiós!" },

        { "t": "Grazie, arrivederci!", "es": "¡Gracias, adiós!", "pron": "grátsie, arrivedérchi" },
        { "t": "Buonasera, scusi!", "es": "¡Buenas tardes, disculpe!", "pron": "buonaséra, scúsi" },

          { "q": "A", "t": "Io sono Luca. Lei è Giulia.", "es": "Yo soy Luca. Ella es Giulia." },
          { "q": "B", "t": "Piacere! Io sono Carlos. Lei è Ana.", "es": "¡Mucho gusto! Yo soy Carlos. Ella es Ana." },
          { "q": "A", "t": "Piacere!", "es": "¡Mucho gusto!" }

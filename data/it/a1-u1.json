        { "t": "ciao", "es": "hola / chao", "pron": "chao", "ej": "Ciao, Luca!", "ejes": "¡Hola, Luca!", "cog": false, "truco": "Sirve para saludar y para despedirse, como «chao»." },
        { "t": "salve", "es": "hola (neutro)", "pron": "sálve", "ej": "Salve, Maria!", "ejes": "¡Hola, Maria!", "cog": true, "truco": "Es un «hola» educado y neutro, ni muy formal ni muy amistoso." },
        { "t": "buongiorno", "es": "buenos días", "pron": "buonyórno", "ej": "Buongiorno, Carlos!", "ejes": "¡Buenos días, Carlos!", "cog": false, "truco": "Buon + giorno (día). Se usa hasta el mediodía y a veces toda la tarde." },
        { "t": "buonasera", "es": "buenas tardes / buenas noches", "pron": "buonaséra", "ej": "Buonasera, Giulia!", "ejes": "¡Buenas tardes, Giulia!", "cog": false, "truco": "Se dice desde la tarde en adelante." },
        { "t": "buonanotte", "es": "buenas noches (al dormir)", "pron": "buonanóte", "ej": "Buonanotte, Marco!", "ejes": "¡Buenas noches, Marco!", "cog": false, "truco": "Solo cuando alguien se va a dormir." },
        { "t": "arrivederci", "es": "adiós / hasta luego", "pron": "arrivedérchi", "ej": "Arrivederci, Ana!", "ejes": "¡Adiós, Ana!", "cog": false },

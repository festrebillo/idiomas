        { "t": "siamo", "es": "somos / estamos", "pron": "siámo", "ej": "Siamo di Roma.", "ejes": "Somos de Roma.", "cog": true },
        { "t": "siete", "es": "son / están (ustedes)", "pron": "siéte", "ej": "Siete del Perù?", "ejes": "¿Son del Perú?", "cog": false, "truco": "No es el número siete en italiano: eso es «sette»." }

        { "t": "la settimana prossima", "es": "la semana próxima", "pron": "la settimána próssima", "ej": "La settimana prossima andrò al mare.", "ejes": "La semana próxima iré a la playa.", "cog": false },
        { "t": "il mese prossimo", "es": "el mes próximo", "pron": "il mése próssimo", "ej": "Il mese prossimo andrò a Roma.", "ejes": "El mes próximo iré a Roma.", "cog": false },
        { "t": "l'anno prossimo", "es": "el año próximo", "pron": "lánno próssimo", "ej": "L'anno prossimo studierò inglese.", "ejes": "El año próximo estudiaré inglés.", "cog": false },

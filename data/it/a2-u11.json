      ],
      "frases": [
        { "t": "Ti prometto che verrò.", "es": "Te prometo que vendré.", "pron": "ti prométto ke verró" },
        { "t": "Lo farò domani.", "es": "Lo haré mañana.", "pron": "lo faró dománi" },
        { "t": "La chiamerò stasera.", "es": "La llamaré esta noche.", "pron": "la quiameró stasséra" },
        { "t": "Li compreremo domani.", "es": "Los compraremos mañana.", "pron": "li comprerémo dománi" },
        { "t": "Le porterò a casa.", "es": "Las llevaré a casa.", "pron": "le porteró a cása" }
      ],

        { "t": "partirò", "es": "partiré / saldré", "pron": "partiró", "ej": "Partirò domani mattina.", "ejes": "Saldré mañana en la mañana.", "cog": false },
        { "t": "finirò", "es": "terminaré", "pron": "finiró", "ej": "Finirò il lavoro presto.", "ejes": "Terminaré el trabajo pronto.", "cog": false },
        { "t": "leggerò", "es": "leeré", "pron": "lleyeró", "ej": "Leggerò un libro.", "ejes": "Leeré un libro.", "cog": false },
        { "t": "scriverò", "es": "escribiré", "pron": "scriveró", "ej": "Ti scriverò una mail.", "ejes": "Te escribiré un correo.", "cog": false },
        { "t": "domani", "es": "mañana", "pron": "dománi", "ej": "Domani è sabato.", "ejes": "Mañana es sábado.", "cog": false }

        { "t": "Qual é o seu endereço?", "es": "¿Cuál es tu dirección?", "pron": "kuáu é u séu enderésu" }
      ],
      "dialogo": {
        "titulo": "Una ficha de datos",
        "lineas": [
          { "q": "A", "t": "Qual é o seu nome?", "es": "¿Cuál es tu nombre?" },
          { "q": "B", "t": "Meu nome é João Pereira.", "es": "Mi nombre es João Pereira." },
          { "q": "A", "t": "Qual é a sua profissão?", "es": "¿Cuál es tu profesión?" },
          { "q": "B", "t": "Eu sou médico. E você?", "es": "Yo soy médico. ¿Y tú?" },
          { "q": "A", "t": "Eu sou estudante. Obrigada!", "es": "Yo soy estudiante. ¡Gracias!" }
        ]
      },
      "nota": "No digas «direção» para tu dirección de casa: «direção» significa dirección de un movimiento o la dirección de una empresa; para tu domicilio usa «endereço». «Estudante» sirve para hombre y mujer."

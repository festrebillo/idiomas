        { "t": "engenheiro", "es": "ingeniero", "pron": "enjeñéiru", "ej": "Carlos é engenheiro.", "ejes": "Carlos es ingeniero.", "cog": true, "truco": "Mujer: engenheira." },
        { "t": "advogado", "es": "abogado", "pron": "adyivogádu", "ej": "Meu amigo é advogado.", "ejes": "Mi amigo es abogado.", "cog": true, "truco": "Mujer: advogada." }
      ],
      "frases": [
        { "t": "Qual é o seu sobrenome?", "es": "¿Cuál es tu apellido?", "pron": "kuáu é u séu sobrenómi" },
        { "t": "Meu sobrenome é Silva.", "es": "Mi apellido es Silva.", "pron": "méu sobrenómi é sílva" },
        { "t": "Qual é a sua profissão?", "es": "¿Cuál es tu profesión?", "pron": "kuáu é a súa profisáun" },

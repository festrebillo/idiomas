  "n": 2,
  "titulo": "Números y datos personales",
  "resumen": "Aprenderás los números del 0 al 100, a decir tu edad y teléfono con el verbo ter, a dar tus datos y a deletrear.",
  "puedo": [
    "Contar del 0 al 100 en portugués.",
    "Decir mi edad con el verbo ter (Eu tenho 25 anos).",
    "Dar y preguntar un número de teléfono.",
    "Dar datos personales: apellido, ciudad, profesión y correo.",
    "Deletrear mi nombre y pedir que me repitan algo."
  ],
  "gramatica": {
    "titulo": "El verbo ter (tener) y la edad",
    "texto": "Para decir la edad, el portugués usa «ter» (tener), igual que el español: Eu tenho 25 anos (Tengo 25 años). No se dice «eu sou 25 anos».\nEl verbo ter es regular en lo que importa: tenho, tem, temos, têm. Truco: la «nh» de «tenho» suena como la «ñ» española (téñu).\n«Você», «ele» y «ela» usan la misma forma: tem. En plural se escribe «têm» (con acento circunflejo) pero se pronuncia casi igual que «tem».\nPara preguntar la edad: Quantos anos você tem? (¿Cuántos años tienes?).",
    "tabla": [
      ["eu tenho", "yo tengo", "éu téñu"],
      ["você tem", "tú tienes", "vosé téin"],
      ["ele / ela tem", "él / ella tiene", "éli / éla téin"],
      ["nós temos", "nosotros tenemos", "nós témus"],
      ["eles / elas têm", "ellos / ellas tienen", "élis / élas téin"]
    ],
    "errores": [
      "No digas «eu sou 25 anos»: para la edad se usa «ter». Correcto: Eu tenho 25 anos.",
      "«Tenho» se escribe con «nh», no «tengo» ni «tenjo»: suena «téñu».",
      "No olvides «anos» al final: «Eu tenho vinte» sin «anos» suena incompleto."
    ]
  },
  "practica": [
    "Cuenta en voz alta del 0 al 20 tres veces seguidas sin mirar (3 minutos).",
    "Di tu edad y la de dos familiares: «Eu tenho... anos. Meu amigo tem... anos» (3 minutos).",
    "Dicta tu número de teléfono en portugués, dígito por dígito, y escríbelo en palabras (5 minutos).",
    "Mira un video corto de «números em português» en YouTube y repite junto con el hablante (5 minutos)."
  ],
  "lecciones": [
    {
      "id": "pt-a1-u2-l1",
      "n": 1,
      "titulo": "Números 0 a 10",
      "objetivo": "Contar del 1 al 10 en portugués y usarlos en frases cortas.",
      "intro": "Los números del 1 al 10 se parecen mucho al español. Truco: «dois» y «três» son las dos que más cambian; las demás son casi iguales (quatro, cinco, seis, sete, oito, nove, dez).",
      "palabras": [
        { "t": "um", "es": "uno", "pron": "ún", "ej": "Um café, por favor.", "ejes": "Un café, por favor.", "cog": true, "truco": "Termina en «m» nasal: ún." },
        { "t": "dois", "es": "dos", "pron": "dois", "ej": "Dois cafés, por favor.", "ejes": "Dos cafés, por favor.", "cog": false },
        { "t": "três", "es": "tres", "pron": "tréis", "ej": "Nós somos três.", "ejes": "Nosotros somos tres.", "cog": true },
        { "t": "quatro", "es": "cuatro", "pron": "kuátru", "ej": "Eles são quatro.", "ejes": "Ellos son cuatro.", "cog": true },
        { "t": "cinco", "es": "cinco", "pron": "sínku", "ej": "Nós somos cinco.", "ejes": "Nosotros somos cinco.", "cog": true },
        { "t": "seis", "es": "seis", "pron": "séis", "ej": "Elas são seis.", "ejes": "Ellas son seis.", "cog": true },
        { "t": "sete", "es": "siete", "pron": "sétchi", "ej": "Nós somos sete.", "ejes": "Nosotros somos siete.", "cog": true, "truco": "La «te» final suena «tchi»: sétchi." },
        { "t": "oito", "es": "ocho", "pron": "óitu", "ej": "Eles são oito.", "ejes": "Ellos son ocho.", "cog": false },
        { "t": "nove", "es": "nueve", "pron": "nóvi", "ej": "Nós somos nove.", "ejes": "Nosotros somos nueve.", "cog": true },
        { "t": "dez", "es": "diez", "pron": "dés", "ej": "Nós somos dez.", "ejes": "Nosotros somos diez.", "cog": true }
      ],
      "frases": [
        { "t": "Um, dois, três!", "es": "¡Uno, dos, tres!", "pron": "ún, dois, tréis" },
        { "t": "Quatro, cinco, seis.", "es": "Cuatro, cinco, seis.", "pron": "kuátru, sínku, séis" },
        { "t": "Sete, oito, nove, dez.", "es": "Siete, ocho, nueve, diez.", "pron": "sétchi, óitu, nóvi, dés" },
        { "t": "Dois cafés, por favor.", "es": "Dos cafés, por favor.", "pron": "dois kafés, por favór" },
        { "t": "Nós somos dez amigos.", "es": "Nosotros somos diez amigos.", "pron": "nós sómus dés amígus" }
      ],
      "dialogo": {
        "titulo": "Contamos juntos",
        "lineas": [
          { "q": "A", "t": "Oi, Luís! Um, dois, três...", "es": "¡Hola, Luís! Uno, dos, tres..." },
          { "q": "B", "t": "Quatro, cinco, seis!", "es": "¡Cuatro, cinco, seis!" },
          { "q": "A", "t": "Sete, oito, nove...", "es": "Siete, ocho, nueve..." },
          { "q": "B", "t": "Dez! Nós somos dez amigos!", "es": "¡Diez! ¡Somos diez amigos!" },
          { "q": "A", "t": "Obrigada, Luís! Até logo!", "es": "¡Gracias, Luís! ¡Hasta luego!" }
        ]
      },
      "nota": "El cero se dice «zero» (zéru) y lo verás en la próxima lección. Pronunciación: la «s» final suena como una «s» suave o «sh» según la región (dois = dois / doish)."
    },
    {

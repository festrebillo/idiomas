        { "t": "profissão", "es": "profesión", "pron": "profisáun", "ej": "Qual é a sua profissão?", "ejes": "¿Cuál es tu profesión?", "cog": true, "truco": "Los cognados en -ión del español terminan en -ão en portugués." },

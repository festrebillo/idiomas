        { "t": "endereço", "es": "dirección (de domicilio)", "pron": "enderésu", "ej": "Qual é o seu endereço?", "ejes": "¿Cuál es tu dirección?", "cog": false, "truco": "La «ç» suena «s»: endereço = enderésu." },
        { "t": "e-mail", "es": "correo electrónico", "pron": "iméiu", "ej": "Qual é o seu e-mail?", "ejes": "¿Cuál es tu correo electrónico?", "cog": true },

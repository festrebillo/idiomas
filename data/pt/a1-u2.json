      "n": 2,
      "titulo": "Números 11 a 20 y decenas hasta 100",
      "objetivo": "Contar hasta 100 con las decenas y leer números de dos cifras.",
      "intro": "Del 11 al 15 se parecen al español (onze, doze, treze, quinze). Para los números compuestos se usa «e»: vinte e um (21), trinta e cinco (35). Truco: el patrón es decena + e + unidad.",
      "palabras": [
        { "t": "zero", "es": "cero", "pron": "zéru", "ej": "Zero, um, dois.", "ejes": "Cero, uno, dos.", "cog": true },
        { "t": "onze", "es": "once", "pron": "ónzi", "ej": "Nós somos onze.", "ejes": "Nosotros somos once.", "cog": true },
        { "t": "doze", "es": "doce", "pron": "dózi", "ej": "Eles são doze.", "ejes": "Ellos son doce.", "cog": true },
        { "t": "treze", "es": "trece", "pron": "trézi", "ej": "Elas são treze.", "ejes": "Ellas son trece.", "cog": true },
        { "t": "quinze", "es": "quince", "pron": "kínzi", "ej": "Nós somos quinze.", "ejes": "Nosotros somos quince.", "cog": true },
        { "t": "vinte", "es": "veinte", "pron": "vínchi", "ej": "Eles são vinte.", "ejes": "Ellos son veinte.", "cog": true },
        { "t": "trinta", "es": "treinta", "pron": "trínta", "ej": "São trinta.", "ejes": "Son treinta.", "cog": true },
        { "t": "cinquenta", "es": "cincuenta", "pron": "sinkuénta", "ej": "São cinquenta.", "ejes": "Son cincuenta.", "cog": true },
        { "t": "noventa", "es": "noventa", "pron": "novénta", "ej": "São noventa.", "ejes": "Son noventa.", "cog": true },
        { "t": "cem", "es": "cien", "pron": "séin", "ej": "Cem por cento!", "ejes": "¡Cien por ciento!", "cog": true, "truco": "«cem» es nasal: séin. Con «um» después: cento e um (101)." }
      ],
      "frases": [
        { "t": "Quatorze, quinze, dezesseis.", "es": "Catorce, quince, dieciséis.", "pron": "katórzi, kínzi, desiséis" },
        { "t": "Dezessete, dezoito, dezenove.", "es": "Diecisiete, dieciocho, diecinueve.", "pron": "desisétchi, dezóitu, dezenóvi" },
        { "t": "Vinte e um, vinte e dois.", "es": "Veintiuno, veintidós.", "pron": "vínchi i ún, vínchi i dois" },
        { "t": "Trinta e cinco.", "es": "Treinta y cinco.", "pron": "trínta i sínku" },
        { "t": "Quarenta, sessenta, oitenta.", "es": "Cuarenta, sesenta, ochenta.", "pron": "kuarénta, sesénta, oiténta" },
        { "t": "Cem por cento!", "es": "¡Cien por ciento!", "pron": "séin por séntu" }
      ],
      "dialogo": {
        "titulo": "Contando de diez en diez",
        "lineas": [
          { "q": "A", "t": "Dez, vinte, trinta!", "es": "¡Diez, veinte, treinta!" },
          { "q": "B", "t": "Quarenta, cinquenta, sessenta!", "es": "¡Cuarenta, cincuenta, sesenta!" },
          { "q": "A", "t": "Setenta, oitenta, noventa!", "es": "¡Setenta, ochenta, noventa!" },
          { "q": "B", "t": "Cem! Cem por cento!", "es": "¡Cien! ¡Cien por ciento!" },
          { "q": "A", "t": "Muito obrigada, Paula!", "es": "¡Muchas gracias, Paula!" }
        ]
      },
      "nota": "Las decenas que faltan: quarenta (40), sessenta (60), setenta (70), oitenta (80). 14 = quatorze (también se oye catorze); 16 = dezesseis; 17 = dezessete; 18 = dezoito; 19 = dezenove. Pronunciación: la «z» entre vocales suena «z» sonora (doze = dózi)."
    },
    {
      "id": "pt-a1-u2-l3",
      "n": 3,
      "titulo": "La edad y el teléfono",
      "objetivo": "Decir tu edad con ter y dar o pedir un número de teléfono.",
      "intro": "Aquí SÍ se usa «tener» como en español: Eu tenho 25 anos. Para el teléfono usarás «Qual é o seu telefone?». Truco: «o/a» antes de «seu/sua» es un artículo; por ahora apréndelo como parte de la frase.",
      "palabras": [
        { "t": "tenho", "es": "tengo", "pron": "téñu", "ej": "Eu tenho vinte anos.", "ejes": "Yo tengo veinte años.", "cog": false, "truco": "«nh» = ñ: tenho = téñu." },
        { "t": "tem", "es": "tiene / tienes (con você)", "pron": "téin", "ej": "Ana tem trinta anos.", "ejes": "Ana tiene treinta años.", "cog": false },
        { "t": "temos", "es": "tenemos", "pron": "témus", "ej": "Nós temos vinte anos.", "ejes": "Nosotros tenemos veinte años.", "cog": true },
        { "t": "anos", "es": "años", "pron": "ánus", "ej": "Eu tenho quinze anos.", "ejes": "Yo tengo quince años.", "cog": true },
        { "t": "idade", "es": "edad", "pron": "idádyi", "ej": "Qual é a sua idade?", "ejes": "¿Cuál es tu edad?", "cog": false },
        { "t": "telefone", "es": "teléfono", "pron": "telefóni", "ej": "Meu telefone é nove, oito, sete.", "ejes": "Mi teléfono es nueve, ocho, siete.", "cog": true },
        { "t": "número", "es": "número", "pron": "númeru", "ej": "Meu número é cinco.", "ejes": "Mi número es cinco.", "cog": true },
        { "t": "quantos", "es": "cuántos", "pron": "kuántus", "ej": "Quantos anos você tem?", "ejes": "¿Cuántos años tienes?", "cog": true },
        { "t": "qual", "es": "cuál", "pron": "kuáu", "ej": "Qual é o seu telefone?", "ejes": "¿Cuál es tu teléfono?", "cog": true, "truco": "La «l» final suena «u»: qual = kuáu." },
        { "t": "seu", "es": "tu / su", "pron": "séu", "ej": "Qual é o seu número?", "ejes": "¿Cuál es tu número?", "cog": false, "truco": "Para algo femenino: sua (la sua idade)." }
      ],
      "frases": [
        { "t": "Quantos anos você tem?", "es": "¿Cuántos años tienes?", "pron": "kuántus ánus vosé téin" },
        { "t": "Eu tenho vinte e cinco anos.", "es": "Yo tengo veinticinco años.", "pron": "éu téñu vínchi i sínku ánus" },
        { "t": "Qual é o seu telefone?", "es": "¿Cuál es tu teléfono?", "pron": "kuáu é u séu telefóni" },
        { "t": "Meu telefone é nove, oito, sete.", "es": "Mi teléfono es nueve, ocho, siete.", "pron": "méu telefóni é nóvi, óitu, sétchi" },
        { "t": "Ele tem trinta anos.", "es": "Él tiene treinta años.", "pron": "éli téin trínta ánus" },
        { "t": "Ana e Paula têm vinte anos.", "es": "Ana y Paula tienen veinte años.", "pron": "ána i páula téin vínchi ánus" }
      ],
      "dialogo": {
        "titulo": "Edad y teléfono",
        "lineas": [
          { "q": "A", "t": "Oi, Carlos! Quantos anos você tem?", "es": "¡Hola, Carlos! ¿Cuántos años tienes?" },
          { "q": "B", "t": "Eu tenho trinta anos. E você?", "es": "Tengo treinta años. ¿Y tú?" },
          { "q": "A", "t": "Eu tenho vinte e cinco anos.", "es": "Tengo veinticinco años." },
          { "q": "B", "t": "Qual é o seu telefone?", "es": "¿Cuál es tu teléfono?" },
          { "q": "A", "t": "Meu telefone é nove, oito, sete, seis, cinco.", "es": "Mi teléfono es nueve, ocho, siete, seis, cinco." },
          { "q": "B", "t": "Obrigado, Ana! Até logo!", "es": "¡Gracias, Ana! ¡Hasta luego!" }
        ]
      },
      "nota": "Con «seu/sua» se suele usar «o/a» delante: o seu telefone, a sua idade. En Brasil también se oye «Qual é seu telefone?». Los números de teléfono se dicen dígito por dígito o en parejas."
    },
    {

        { "t": "A calça está muito grande.", "es": "El pantalón me queda muy grande.", "pron": "a kálsa está múintu grándyi" },
        { "t": "A camisa está muito pequena.", "es": "La camisa me queda muy pequeña.", "pron": "a kamíza está múintu pekéna" },
